# Copie para .env e ajuste:  cp .env.exemplo .env
# O .env não vai para o git. No CI, as mesmas variáveis vêm do cofre de segredos.
# O que já estiver definido no terminal ganha do arquivo.

# Credenciais da cliente de teste
TATU_CPF=123.456.789-09
TATU_SENHA=segredo123

# Testar um ambiente que já está no ar (desliga o webServer)
# BASE_URL=https://homologacao.exemplo

# Navegador num container (docker compose --profile navegador up navegador)
# PW_NAVEGADOR_REMOTO=ws://127.0.0.1:3000/

# Monitoramento (npm run vigia)
# VIGIA_URL=http://localhost:4200
# VIGIA_LIMITE_MS=5000
